{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemoport.io/schemas/canonical-asset.schema.json",
  "title": "MnemoPort Canonical Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "kind",
    "scope",
    "title",
    "content_hash",
    "sensitivity",
    "provenance",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "asset_id": { "$ref": "#/$defs/hash" },
    "kind": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "prompt",
        "preference",
        "memory",
        "plugin",
        "handoff",
        "inventory_only"
      ]
    },
    "scope": {
      "enum": ["organization", "user", "device", "workspace", "project", "session"]
    },
    "title": { "type": "string", "minLength": 1 },
    "content_hash": { "$ref": "#/$defs/hash" },
    "sensitivity": {
      "enum": ["public", "private", "secret_reference", "quarantined"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "locator", "evidence", "source_hash", "model_inferred"],
      "properties": {
        "platform": { "enum": ["claude-code", "codex", "qoder", "cursor"] },
        "locator": { "type": "string", "minLength": 1 },
        "evidence": {
          "enum": ["documented", "observed", "probe", "official_interface", "excluded"]
        },
        "source_hash": { "$ref": "#/$defs/hash" },
        "model_inferred": { "type": "boolean" },
        "workspace_id": { "$ref": "#/$defs/hash" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["text", "file_tree", "mcp_server", "plugin_intent", "inventory", "handoff"]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "plugin_intent" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/pluginIntent" } } }
        }
      ]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pluginIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "type": "string", "minLength": 1, "maxLength": 512 },
        "ecosystem": {
          "enum": [
            "claude-code-plugin",
            "codex-plugin",
            "qoder-plugin",
            "cursor-agent-plugin",
            "cursor-plugin",
            "cursor-ide-extension"
          ]
        },
        "subtype": { "enum": ["native_plugin", "agent_plugin", "ide_extension"] },
        "requested_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resolved_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scope": {
          "enum": [
            "organization",
            "user",
            "project",
            "local",
            "managed",
            "profile",
            "device",
            "unknown"
          ]
        },
        "entrypoint": {
          "enum": ["cli", "desktop-app", "ide-editor", "jetbrains", "agent", "unknown"]
        },
        "enabled": { "type": "boolean" },
        "install_policy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "auth_policy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inventory_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_version", "arguments", "output_hash", "structured"],
          "properties": {
            "product_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "output_hash": { "$ref": "#/$defs/hash" },
            "structured": { "type": "boolean" }
          }
        },
        "compensation": { "enum": ["official_remove_if_permitted", "manual"] }
      }
    }
  }
}
