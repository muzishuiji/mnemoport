{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemoport.dev/schemas/command-response/1.0.json",
  "title": "MnemoPort command response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "phase", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "type": "string", "format": "uuid" },
    "phase": { "type": "string", "minLength": 1 },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}

